# --- 機密情報 -------------------------------------------------------------
# .env には Postgres の認証情報が入る。一度コミットすると履歴から消すのが
# 非常に面倒なので、最初から追跡させない。雛形の .env.example だけ共有する。
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# --- 依存 -----------------------------------------------------------------
node_modules/
.pnpm-store/

# --- ビルド成果物 ---------------------------------------------------------
dist/
build/
*.tsbuildinfo

# --- テスト ---------------------------------------------------------------
coverage/

# --- ログ・一時ファイル ---------------------------------------------------
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store

# --- エディタ -------------------------------------------------------------
.idea/

# --- Claude Code -----------------------------------------------------------
# settings.json（プロジェクト共通）はコミットする。
# settings.local.json は個人の上書き用なので追跡しない。
.claude/settings.local.json
