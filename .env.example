# このファイルをコピーして .env を作る:
#   cp .env.example .env
#
# .env は .gitignore されており、コミットされない。
# 値を変えたときは、この雛形の側も更新すること（キーの増減が伝わらなくなるため）。

# Postgres への接続情報。docker-compose.yml の設定と揃えること。
DATABASE_URL=postgres://attendance:attendance@localhost:5433/attendance

# テスト用 DB。テストの開始時に毎回作り直される（DROP → CREATE → マイグレーション）。
# 名前が _test で終わらない DB を指定すると、テストは起動を拒否する。
# 開発用 DB を誤って消さないための安全装置（apps/api/test/db-guard.ts）。
TEST_DATABASE_URL=postgres://attendance:attendance@localhost:5433/attendance_test

# API サーバのポート。web 側の vite.config.ts の proxy 先と揃えること。
PORT=3000
